# Clang-only hardening from the postmarketOS base config
# CONFIG_CFI is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_MODULE_COMPRESS is not set

# Storage needed before userspace: eMMC and loop for the userdata disk image
CONFIG_MMC_SDHCI_MSM=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EROFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y

# USB: dwc3 is forced to host mode by the device tree, the dongle and the
# Ethernet adapter attach through the hub
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_ACM=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_RTL8153_ECM=m

# Needed for the OpenThread Border Router
CONFIG_NF_TABLES=m
CONFIG_NFT_COMPAT=m
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_MAC=m
CONFIG_NETFILTER_XT_SET=m
